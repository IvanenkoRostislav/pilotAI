{
  "name": "tablepilot-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI agent for restaurant reservations through Telegram.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "pretest": "npm run build",
    "test": "node --test src/modules/agent/agent.test.mjs src/modules/agent/integration.test.mjs"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@google/genai": "3.4.0",
    "dotenv": "^18.0.10",
    "teleproto": "^1.233.0"
  }
}
